# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# preprocessed data (extracted from .gz during build)
/public/data/**
# Allow compressed data files
!/public/data/*.gz
# mof-budget-overview-{YEAR}.json: .gz only（10年度分。CSVから再生成できる生成物）、ビルド時に自動展開
# Allow houjin lookup (NTA corporate number subset for entities browser, ~2.4MB)
!/public/data/houjin-lookup.json
# Allow entity labels (generated by generate-entity-labels-csv.py, ~4MB)
!/public/data/entity-labels-csv.json
# project-quality-scores-{YEAR}.json: .gz only（AI再設計で5.8〜7.0MB→0.6〜1.0MB）、ビルド時に自動展開
# project-quality-recipients-{YEAR}.json: .gz only（28MB→3MB）、ビルド時に自動展開
# 生JSONはGit管理対象外（!/public/data/*.gz で .gz のみ許可済み）
# Allow entity normalization dict (curated mapping, needed to regenerate structured JSON)
!/public/data/entity-normalization.json
# Allow entity labeling dictionaries (exact-match label CSVs, generated by scripts/generate-*.py)
!/public/data/dictionaries/
!/public/data/dictionaries/*.csv

# raw CSV data (939MB) and build artifacts (houjin.db etc.)
/data/

# IDE
.vscode/
.idea/
.claude/settings.local.json
# Private Team Mirai design system skill (including local copies)
/.claude/skills/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python cache
__pycache__/
*.pyc

# 埋め込みキャッシュ（scripts/generate-project-map.py・数百MB。消しても再取得できる）
/.cache/

# --- IGNORE ---
docs/*ignore*
docs/image*.png

# editor backups and local worktrees
.env~
*.un~
.worktrees/
infra/terraform/*.tfplan
/.next-*/
debug.log

# 再配布制限のある一次資料の原本（URL と SHA-256 のみ manifest に記録。IMF/OECD）
tests/fixtures/fiscal-debt/imf-cr26-75.pdf
tests/fixtures/fiscal-demographics/imf_sip_2024-025_japan_fertility.pdf
tests/fixtures/fiscal-demographics/oecd_selsa_wp299_fertility_family_policy_2023.pdf
